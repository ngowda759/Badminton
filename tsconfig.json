{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "allowImportingTsExtensions": true
  },
  "include": [
    "apps/api/src",
    "apps/api/tests",
    "packages/domain/src",
    "packages/validation/src",
    "packages/database/src",
    "packages/config/src",
    "prisma",
    "tests",
    "vitest.config.ts",
    "playwright.config.ts",
    "prisma.config.ts"
  ],
  "exclude": ["node_modules", "**/dist", "**/generated"]
}
