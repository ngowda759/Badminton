{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/ngowda759/Badminton/.ai/schemas/loop-config.schema.json",
  "title": "Badminton AI development loop configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "loopId",
    "maxReviewRounds",
    "baseBranch",
    "branchPrefix",
    "ciWorkflow",
    "requiredChecks",
    "protectedPaths",
    "mergeGate",
    "automation",
    "limits",
    "paths"
  ],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "loopId": { "type": "string", "pattern": "^AI-[0-9]+$" },
    "maxReviewRounds": { "type": "integer", "minimum": 1, "maximum": 10 },
    "baseBranch": { "type": "string", "minLength": 1 },
    "branchPrefix": { "type": "string", "minLength": 1 },
    "ciWorkflow": { "type": "string", "minLength": 1 },
    "requiredChecks": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "protectedPaths": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": { "type": "array", "items": { "type": "string" } },
        "optional": { "type": "array", "items": { "type": "string" } },
        "note": { "type": "string" }
      }
    },
    "mergeGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "requireCiGreen", "requireReviewPassed", "requireHumanApproval"],
      "properties": {
        "enabled": { "type": "boolean" },
        "requireCiGreen": { "type": "boolean" },
        "requireReviewPassed": { "type": "boolean" },
        "requireHumanApproval": { "type": "boolean" }
      }
    },
    "reviewers": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "automation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["triggerLabel", "reviewLabel", "blockedLabel", "readyLabel"],
      "properties": {
        "triggerLabel": { "type": "string", "minLength": 1 },
        "reviewLabel": { "type": "string", "minLength": 1 },
        "blockedLabel": { "type": "string", "minLength": 1 },
        "readyLabel": { "type": "string", "minLength": 1 },
        "nextTaskEnabled": { "type": "boolean" },
        "nextTaskBranchPrefix": { "type": "string", "minLength": 1 }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxChangedFiles": { "type": "integer", "minimum": 1 },
        "maxDiffLines": { "type": "integer", "minimum": 1 }
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "queue", "reviewLog"],
      "properties": {
        "state": { "type": "string", "minLength": 1 },
        "queue": { "type": "string", "minLength": 1 },
        "reviewLog": { "type": "string", "minLength": 1 }
      }
    }
  }
}
