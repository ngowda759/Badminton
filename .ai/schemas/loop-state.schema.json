{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/ngowda759/Badminton/.ai/schemas/loop-state.schema.json",
  "title": "Badminton AI development loop state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "loopId",
    "status",
    "round",
    "maxReviewRounds",
    "currentTaskId",
    "currentPr",
    "updatedAt",
    "history"
  ],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "loopId": { "type": "string", "pattern": "^AI-[0-9]+$" },
    "status": {
      "type": "string",
      "enum": [
        "idle",
        "task-selected",
        "implementing",
        "ci-running",
        "reviewing",
        "fixing",
        "ready",
        "merge-gate",
        "human-merge",
        "blocked",
        "complete"
      ]
    },
    "round": { "type": "integer", "minimum": 0 },
    "maxReviewRounds": { "type": "integer", "minimum": 1, "maximum": 10 },
    "currentTaskId": { "type": ["string", "null"] },
    "currentPr": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["number", "branch", "headSha"],
      "properties": {
        "number": { "type": "integer", "minimum": 1 },
        "branch": { "type": "string", "minLength": 1 },
        "headSha": { "type": "string", "minLength": 7 }
      }
    },
    "updatedAt": { "type": "string", "format": "date-time" },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["at", "status", "note"],
        "properties": {
          "at": { "type": "string", "format": "date-time" },
          "status": { "type": "string" },
          "note": { "type": "string" }
        }
      }
    }
  }
}
