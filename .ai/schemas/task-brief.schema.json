{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/ngowda759/Badminton/.ai/schemas/task-brief.schema.json",
  "title": "Badminton AI development loop task brief",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "phase",
    "status",
    "summary",
    "acceptanceCriteria",
    "outOfScope",
    "humanApproval",
    "createdAt"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^AI-[0-9]+(-T[0-9]+)?$" },
    "title": { "type": "string", "minLength": 1 },
    "phase": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["proposed", "approved", "queued", "in-progress", "in-review", "blocked", "done"]
    },
    "summary": { "type": "string", "minLength": 1 },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "outOfScope": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "humanApproval": { "type": "boolean" },
    "dependsOn": {
      "type": "array",
      "items": { "type": "string", "pattern": "^AI-[0-9]+(-T[0-9]+)?$" }
    },
    "references": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "createdAt": { "type": "string", "format": "date-time" }
  }
}
