{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/ngowda759/Badminton/.ai/schemas/review-report.schema.json",
  "title": "Badminton AI development loop review report",
  "type": "object",
  "additionalProperties": false,
  "required": ["taskId", "pr", "round", "verdict", "findings", "reviewedAt"],
  "properties": {
    "taskId": { "type": "string", "pattern": "^AI-[0-9]+(-T[0-9]+)?$" },
    "pr": { "type": "integer", "minimum": 1 },
    "round": { "type": "integer", "minimum": 1, "maximum": 10 },
    "headSha": { "type": "string", "minLength": 7 },
    "verdict": {
      "type": "string",
      "enum": ["approved", "changes-requested", "blocked"]
    },
    "ciStatus": {
      "type": "string",
      "enum": ["pending", "success", "failure", "cancelled", "skipped", "unknown"]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "file", "summary"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "severity": {
            "type": "string",
            "enum": ["blocker", "major", "minor", "nit"]
          },
          "file": { "type": "string", "minLength": 1 },
          "line": { "type": "integer", "minimum": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "suggestion": { "type": "string" }
        }
      }
    },
    "reviewedAt": { "type": "string", "format": "date-time" }
  }
}
