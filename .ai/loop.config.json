{
  "version": 1,
  "loopId": "AI-001",
  "maxReviewRounds": 3,
  "baseBranch": "main",
  "branchPrefix": "automation/",
  "ciWorkflow": "CI",
  "requiredChecks": ["Lint, typecheck, test, build"],
  "protectedPaths": [
    "prisma/migrations/**",
    "prisma/seed.ts",
    ".github/workflows/ci.yml",
    ".env",
    ".env.*"
  ],
  "secrets": {
    "required": ["OPENHANDS_API_KEY", "OPENAI_API_KEY"],
    "optional": ["OPENHANDS_HOST", "OPENAI_REVIEW_MODEL"],
    "note": "GITHUB_TOKEN is provided by GitHub Actions and must never be committed. OPENHANDS_HOST and OPENAI_REVIEW_MODEL are Actions variables, not secrets. OPENAI_API_KEY is the ChatGPT reviewer credential; OPENHANDS_API_KEY is the implementer/fixer credential."
  },
  "review": {
    "provider": "openai",
    "endpoint": "https://api.openai.com/v1/responses",
    "model": "gpt-5.6-sol",
    "modelEnvVar": "OPENAI_REVIEW_MODEL",
    "schema": ".ai/schemas/review-report.schema.json",
    "markerName": "ai-loop-review",
    "commentOnEveryRound": true
  },
  "mergeGate": {
    "enabled": false,
    "requireCiGreen": true,
    "requireReviewPassed": true,
    "requireHumanApproval": true
  },
  "reviewers": {
    "architect": "ChatGPT",
    "implementer": "OpenHands",
    "ci": "GitHub Actions"
  },
  "automation": {
    "triggerLabel": "ai-task",
    "reviewLabel": "ai-review",
    "blockedLabel": "ai-blocked",
    "readyLabel": "ai-ready",
    "nextTaskEnabled": true,
    "nextTaskBranchPrefix": "automation/next-task-"
  },
  "limits": {
    "maxChangedFiles": 60,
    "maxDiffLines": 2500
  },
  "paths": {
    "state": ".ai/state/loop-state.json",
    "queue": ".ai/state/task-queue.json",
    "reviewLog": ".ai/state/review-log.jsonl"
  }
}
