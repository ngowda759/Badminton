{
  "name": "badminton",
  "version": "0.1.0",
  "private": true,
  "description": "Badminton V2 - tournament management platform (Phase 1 foundation)",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently --names api,web --prefix-colors cyan,magenta --kill-others-on-fail \"npm:dev:api\" \"npm:dev:web\"",
    "start:local": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-local.ps1",
    "dev:api": "npm run dev --workspace @badminton/api",
    "dev:web": "npm run dev --workspace @badminton/web",
    "build": "npm run build --workspace @badminton/api && npm run build --workspace @badminton/web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck --workspace @badminton/web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run && npm run test --workspace @badminton/web",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.3",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "4.1.11",
    "concurrently": "10.0.5",
    "dotenv": "18.0.4",
    "eslint": "10.0.1",
    "eslint-plugin-react-hooks": "7.1.0",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "prisma": "7.10.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "fastify": "5.12.5",
    "pg": "8.16.3",
    "zod": "4.6.5"
  }
}
