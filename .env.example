# ---------------------------------------------------------------------------
# Badminton V2 - environment template
#
# Copy this file to `.env` and adjust the values for your machine:
#
#   cp .env.example .env
#
# `.env` is gitignored. Never commit real credentials.
# All variables below are validated with Zod at startup (packages/config).
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
# development | test | production
NODE_ENV=development

# --- API (server-only, never exposed to the browser) -----------------------
API_PORT=3000
# Comma-separated list of browser origins allowed to call the API.
# Both hostnames are listed because `localhost` and `127.0.0.1` are distinct
# origins to a browser. An empty value disables CORS entirely (fails closed).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# debug | info | warn | error
LOG_LEVEL=info
# Whether to trust `X-Forwarded-*` headers from a reverse proxy. Leave false
# unless a proxy that overwrites those headers runs in front of the API;
# trusting them blindly lets a client forge its own IP and protocol.
# Accepts exactly "true" or "false".
TRUST_PROXY=false

# --- Web (Vite dev server) -------------------------------------------------
WEB_PORT=5173
# Base URL the browser uses to reach the API. Vite only exposes variables
# prefixed with `VITE_` to client code, so this must never hold a secret.
VITE_API_BASE_URL=http://localhost:3000

# --- Database --------------------------------------------------------------
# Local development uses the docker-compose PostgreSQL service.
DATABASE_URL=postgresql://badminton:badminton@localhost:5432/badminton?schema=public

# Optional. Supabase exposes a pooled connection (DATABASE_URL) for the app and a
# direct connection (DIRECT_URL) for migrations/DDL. Set DIRECT_URL only when the
# two differ - for example against Supabase:
#   DATABASE_URL=postgresql://postgres.<ref>:<password>@<host>:6543/postgres
#   DIRECT_URL=postgresql://postgres.<ref>:<password>@<host>:5432/postgres
# Local Docker defines DATABASE_URL only; Prisma falls back to it for migrations.
# Never commit real credentials.
# DIRECT_URL=

# Credentials consumed by docker-compose to provision the local database
# container. Keep them in sync with DATABASE_URL above.
POSTGRES_USER=badminton
POSTGRES_PASSWORD=badminton
POSTGRES_DB=badminton
POSTGRES_PORT=5432
