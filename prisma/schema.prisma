// Badminton V2 schema.
//
// Phase 1 (`SystemMetadata`) is infrastructure bookkeeping that proves the
// PostgreSQL connection end to end and is deliberately unchanged.
//
// Phase 2 adds the tournament domain: Tournament, TournamentCategory, Player,
// Team, TeamMember, TournamentEntry, TournamentStage, Match and
// MatchParticipant. The model follows `docs/phase-2-domain-design.md`.
//
// Prisma cannot express every constraint the design requires (row-local CHECKs
// and partial unique indexes). Those are added as hand-written SQL in the
// `add_tournament_domain` migration. Cross-table business rules are owned by
// the future service layer - no database triggers.

generator client {
  provider = "prisma-client"
  output   = "../packages/database/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Phase 1 - foundation
// ---------------------------------------------------------------------------

model SystemMetadata {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_metadata")
}

// ---------------------------------------------------------------------------
// Phase 2 - tournament domain
// ---------------------------------------------------------------------------

enum TournamentStatus {
  DRAFT
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum CategoryFormat {
  SINGLES
  DOUBLES
}

enum CategoryGender {
  MALE
  FEMALE
  MIXED
  OPEN
}

enum CategoryStatus {
  DRAFT
  OPEN
  CLOSED
  COMPLETED
  CANCELLED
}

enum EntryStatus {
  PENDING
  CONFIRMED
  WITHDRAWN
  DISQUALIFIED
}

enum StageType {
  GROUP
  KNOCKOUT
}

enum StageStatus {
  PENDING
  ACTIVE
  COMPLETED
}

enum MatchStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum CourtStatus {
  ACTIVE
  INACTIVE
}

model Tournament {
  id          String               @id @default(uuid()) @db.Uuid
  name        String
  description String?
  startDate   DateTime             @db.Date
  endDate     DateTime             @db.Date
  location    String?
  timezone    String
  status      TournamentStatus     @default(DRAFT)
  categories  TournamentCategory[]
  courts      Court[]
  createdAt   DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime             @updatedAt @db.Timestamptz(3)

  @@index([status])
  @@index([startDate])
  @@map("tournaments")
}

model TournamentCategory {
  id           String            @id @default(uuid()) @db.Uuid
  tournamentId String            @db.Uuid
  tournament   Tournament        @relation(fields: [tournamentId], references: [id], onDelete: Restrict)
  name         String
  code         String
  format       CategoryFormat
  gender       CategoryGender?
  status       CategoryStatus    @default(DRAFT)
  entries      TournamentEntry[]
  stages       TournamentStage[]
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime          @updatedAt @db.Timestamptz(3)

  @@unique([tournamentId, code])
  @@map("tournament_categories")
}

model Player {
  id          String            @id @default(uuid()) @db.Uuid
  name        String
  email       String?
  phone       String?
  entries     TournamentEntry[]
  teamMembers TeamMember[]
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @db.Timestamptz(3)

  @@index([name])
  @@map("players")
}

model Team {
  id        String            @id @default(uuid()) @db.Uuid
  name      String
  members   TeamMember[]
  entries   TournamentEntry[]
  createdAt DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt DateTime          @updatedAt @db.Timestamptz(3)

  @@map("teams")
}

model TeamMember {
  id        String   @id @default(uuid()) @db.Uuid
  teamId    String   @db.Uuid
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  playerId  String   @db.Uuid
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Restrict)
  position  Int      @default(1) @db.SmallInt
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([teamId, playerId])
  @@index([playerId])
  @@map("team_members")
}

model TournamentEntry {
  id           String             @id @default(uuid()) @db.Uuid
  categoryId   String             @db.Uuid
  category     TournamentCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  playerId     String?            @db.Uuid
  player       Player?            @relation(fields: [playerId], references: [id], onDelete: Restrict)
  teamId       String?            @db.Uuid
  team         Team?              @relation(fields: [teamId], references: [id], onDelete: Restrict)
  seed         Int?
  status       EntryStatus        @default(PENDING)
  registeredAt DateTime           @default(now()) @db.Timestamptz(3)
  participants MatchParticipant[]
  wonMatches   Match[]            @relation("MatchWinner")
  createdAt    DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime           @updatedAt @db.Timestamptz(3)

  @@index([categoryId])
  @@index([playerId])
  @@index([teamId])
  @@map("tournament_entries")
}

model TournamentStage {
  id         String             @id @default(uuid()) @db.Uuid
  categoryId String             @db.Uuid
  category   TournamentCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  name       String
  type       StageType
  sequence   Int                @db.SmallInt
  drawSize   Int?               @db.SmallInt
  status     StageStatus        @default(PENDING)
  matches    Match[]
  createdAt  DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime           @updatedAt @db.Timestamptz(3)

  @@unique([categoryId, sequence])
  @@map("tournament_stages")
}

model Match {
  id               String             @id @default(uuid()) @db.Uuid
  stageId          String             @db.Uuid
  stage            TournamentStage    @relation(fields: [stageId], references: [id], onDelete: Restrict)
  sequence         Int                @db.SmallInt
  roundNumber      Int?               @db.SmallInt
  matchNumber      Int?
  status           MatchStatus        @default(SCHEDULED)
  winnerEntryId    String?            @db.Uuid
  winnerEntry      TournamentEntry?   @relation("MatchWinner", fields: [winnerEntryId], references: [id], onDelete: Restrict)
  courtId          String?            @db.Uuid
  court            Court?             @relation(fields: [courtId], references: [id], onDelete: Restrict)
  scheduledStartAt DateTime?          @db.Timestamptz(3)
  scheduledEndAt   DateTime?          @db.Timestamptz(3)
  participants     MatchParticipant[]
  games            MatchGame[]
  createdAt        DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime           @updatedAt @db.Timestamptz(3)

  @@unique([stageId, sequence])
  @@index([status])
  @@index([winnerEntryId])
  @@index([courtId, scheduledStartAt])
  @@index([scheduledStartAt])
  @@map("matches")
}

model MatchParticipant {
  id        String          @id @default(uuid()) @db.Uuid
  matchId   String          @db.Uuid
  match     Match           @relation(fields: [matchId], references: [id], onDelete: Cascade)
  entryId   String          @db.Uuid
  entry     TournamentEntry @relation(fields: [entryId], references: [id], onDelete: Restrict)
  slot      Int             @db.SmallInt
  createdAt DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt DateTime        @updatedAt @db.Timestamptz(3)

  @@unique([matchId, slot])
  @@unique([matchId, entryId])
  @@index([entryId])
  @@map("match_participants")
}

// ---------------------------------------------------------------------------
// Phase 5 - group-stage scoring
// ---------------------------------------------------------------------------

// A single game in a best-of-three badminton match. Points belong to the two
// participant slots (1 and 2), so the model stays agnostic to singles and
// doubles; the winning slot is stored so a completed result can be read back
// without re-deriving it. Row-local CHECKs that Prisma cannot express are added
// in the `add_match_scoring` migration.
model MatchGame {
  id                 String   @id @default(uuid()) @db.Uuid
  matchId            String   @db.Uuid
  match              Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  gameNumber         Int      @db.SmallInt
  participant1Points Int      @db.SmallInt
  participant2Points Int      @db.SmallInt
  winnerSlot         Int      @db.SmallInt
  createdAt          DateTime @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)

  @@unique([matchId, gameNumber])
  @@map("match_games")
}

// ---------------------------------------------------------------------------
// Phase 7 - court management and match scheduling
// ---------------------------------------------------------------------------

// A physical court within a tournament. Court numbers are unique per tournament
// and `status` is the only lifecycle state; "busy" is derived from the matches
// scheduled on the court. The scheduling overlap invariant (two matches on the
// same court must not overlap in time) is a PostgreSQL GiST exclusion constraint
// that Prisma cannot express, added in the `add_courts_scheduling` migration.
model Court {
  id           String      @id @default(uuid()) @db.Uuid
  tournamentId String      @db.Uuid
  tournament   Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Restrict)
  number       Int         @db.SmallInt
  name         String
  status       CourtStatus @default(ACTIVE)
  matches      Match[]
  createdAt    DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime    @updatedAt @db.Timestamptz(3)

  @@unique([tournamentId, number])
  @@index([tournamentId, status])
  @@map("courts")
}
